#!/usr/bin/env bash
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO_ROOT"
# Dependencies are installed when the capsule environment is built.
# Use this checkout's src package directly, including in an offline capsule.
export PYTHONPATH="$REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec bash scripts/reproduce_paper.sh "$@"
